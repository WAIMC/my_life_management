# ============================================
# Docker Environment Configuration Template
# ============================================
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Update the values below according to your environment
# 3. Never commit .env file to version control

# --------------------------------------------
# NGINX Configuration
# --------------------------------------------
NGINX_PORT_INSIDE_ENV=80
NGINX_PORT_OUTSIDE_ENV=81
NGINX_PORT_SECURE_INSIDE_ENV=443
NGINX_PORT_SECURE_OUTSIDE_ENV=8443

# --------------------------------------------
# Laravel API Configuration
# --------------------------------------------
LARAVEL_PORT=9000

# --------------------------------------------
# Next.js Frontend Configuration
# --------------------------------------------
NEXTJS_PORT_INSIDE_ENV=6543
NEXTJS_PORT_OUTSIDE_ENV=3456

# --------------------------------------------
# PostgreSQL Database Configuration
# --------------------------------------------
POSTGRES_HOST_INSIDE_ENV=ml-postgres
POSTGRES_HOST_OUTSIDE_ENV=localhost
POSTGRES_PORT_INSIDE_ENV=5432
POSTGRES_PORT_OUTSIDE_ENV=5502

# CHANGE THESE IN PRODUCTION!
POSTGRES_USER=ml_pg_user
POSTGRES_PASSWORD=ml_pg_password
POSTGRES_DB=ml_pg_db

# --------------------------------------------
# Redis Cache/Session Configuration
# --------------------------------------------
REDIS_HOST_INSIDE_ENV=ml-redis
REDIS_HOST_OUTSIDE_ENV=localhost
REDIS_PORT_INSIDE_ENV=6379
REDIS_PORT_OUTSIDE_ENV=6601

# CHANGE THIS IN PRODUCTION!
REDIS_PASSWORD=ml_redis_password

# --------------------------------------------
# Additional Settings
# --------------------------------------------
TZ=Asia/Ho_Chi_Minh
NODE_ENV=production
