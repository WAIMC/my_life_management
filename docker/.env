# ============================================
# Docker Environment Configuration
# ============================================
# This file contains all environment variables for the Docker stack
# Copy this file to .env and adjust values as needed
# PHP-FPM port (internal only, not exposed to host)
LARAVEL_PORT=9000

# --------------------------------------------
# Next.js Frontend Configuration
# --------------------------------------------
# Next.js application ports (Main frontend)
NEXTJS_PORT_INSIDE_ENV=6543
NEXTJS_PORT_OUTSIDE_ENV=3456

# Next.js Docs ports (Documentation frontend)
NEXTJS_DOCS_PORT_INSIDE_ENV=3457
NEXTJS_DOCS_PORT_OUTSIDE_ENV=3457

# --------------------------------------------
# PostgreSQL Database Configuration
# --------------------------------------------
# PostgreSQL 16 - Main application database
# Inside host: Service name used within Docker network
# Outside host: localhost or IP used from host machine

POSTGRES_HOST_INSIDE_ENV=ml-postgres
POSTGRES_HOST_OUTSIDE_ENV=localhost
POSTGRES_PORT_INSIDE_ENV=5432
POSTGRES_PORT_OUTSIDE_ENV=5502

# Database credentials
POSTGRES_USER=ml_pg_user
POSTGRES_PASSWORD=6c664e9c4e6a2a7d40cce9fc306b6994
POSTGRES_DB=ml_pg_db

# --------------------------------------------
# Redis Cache/Session Configuration
# --------------------------------------------
# Redis 7 - Caching and session storage
# Inside host: Service name used within Docker network
# Outside host: localhost or IP used from host machine

REDIS_HOST_INSIDE_ENV=ml-redis
REDIS_HOST_OUTSIDE_ENV=ml_redis_password
REDIS_PORT_INSIDE_ENV=6379
REDIS_PORT_OUTSIDE_ENV=6601

# Redis authentication
REDIS_PASSWORD=3e3ba90cc1d3e64810a2770e6d24100b

# --------------------------------------------
# Additional Settings (Optional)
# --------------------------------------------

# Timezone
TZ=Asia/Ho_Chi_Minh

# Node Environment (production | development)
NODE_ENV=development

# PHP Environment (production | development)
APP_ENV=local
APP_DEBUG=true

# --------------------------------------------
# Docker Build Tag (auto-generated)
# --------------------------------------------
# This tag is automatically managed by build.sh
# Do not modify manually
DOCKER_TAG=86e3f81a-c5e7-406b-84fc-e88ef1a738b1

# --------------------------------------------
# NGINX Configuration
# --------------------------------------------
NGINX_PORT_INSIDE_ENV=80
NGINX_PORT_OUTSIDE_ENV=81
NGINX_PORT_SECURE_INSIDE_ENV=443
NGINX_PORT_SECURE_OUTSIDE_ENV=8443

# --------------------------------------------
# MinIO Object Storage Configuration
# --------------------------------------------
# MinIO - S3-compatible object storage
# Inside host: Service name used within Docker network
# Outside host: localhost or IP used from host machine

MINIO_HOST_INSIDE_ENV=ml-minio
MINIO_HOST_OUTSIDE_ENV=localhost
MINIO_PORT_INSIDE_ENV=9000
MINIO_PORT_OUTSIDE_ENV=9100
MINIO_CONSOLE_PORT_INSIDE_ENV=9001
MINIO_CONSOLE_PORT_OUTSIDE_ENV=9102

# MinIO credentials
MINIO_ROOT_USER=ml_minio_admin
MINIO_ROOT_PASSWORD=188679d8c03daee3a34499f8ab233958

# MinIO buckets
MINIO_BUCKET_OFFICIAL=media-official
MINIO_BUCKET_TEMP=media-temp

# MinIO IAM User (for Laravel)
MINIO_IAM_USER=backend-user
MINIO_IAM_PASSWORD=b5355d724dc329670de27ad7db073d9e

# MinIO settings
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9100

# --------------------------------------------
# Reverb (WebSocket) Configuration
# --------------------------------------------
REVERB_APP_ID=my-app-id
REVERB_APP_KEY=44f85d6ed68b5c58edca11b7077e5837
REVERB_APP_SECRET=2eb892eca3a516844fa8bd1f84dd354f
REVERB_HOST="0.0.0.0"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PORT_OUTSIDE_ENV=8080

# Broadcasting client (for queue workers & PHP-FPM to connect to Reverb)
# Use Docker service name for internal connections
REVERB_SERVER_HOST=ml-reverb

BROADCAST_CONNECTION=reverb

# Rclone Backup Configuration
PROJECT_DIR=/home/vinhdv/projects/second-memory
DOCKER_DIR=/home/vinhdv/projects/second-memory/docker
# RCLONE_REMOTES=ggdrive:second-memory-backups,onedrive:second-memory-backups
RCLONE_REMOTES=ggdrive:second-memory-backups

LARAVEL_APP_KEY=base64:u1ufVYalGTU9myh/EyjjrbZ2oRUKzQOmw8B2pjoA7rU=
LARAVEL_ACCESS_TOKEN_SECRET=base64:4fqh36uNJu69nyjNIgdWiRzIbHMVXaEedAEHTWfXjlU=
LARAVEL_REFRESH_TOKEN_SECRET=base64:hKWnaTIyBQUDHLtJhR6COLqKbsIZWXzAUKVclOXzA9I=
