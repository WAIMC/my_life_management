# ============================================
# Docker Environment Configuration
# ============================================
# This file contains all environment variables for the Docker stack
# Copy this file to .env and adjust values as needed
# PHP-FPM port (internal only, not exposed to host)
LARAVEL_PORT=9000

# --------------------------------------------
# Next.js Frontend Configuration
# --------------------------------------------
# Next.js application ports
NEXTJS_PORT_INSIDE_ENV=6543
NEXTJS_PORT_OUTSIDE_ENV=3456

# --------------------------------------------
# PostgreSQL Database Configuration
# --------------------------------------------
# PostgreSQL 16 - Main application database
# Inside host: Service name used within Docker network
# Outside host: localhost or IP used from host machine

POSTGRES_HOST_INSIDE_ENV=ml-postgres
POSTGRES_HOST_OUTSIDE_ENV=localhost
POSTGRES_PORT_INSIDE_ENV=5432
POSTGRES_PORT_OUTSIDE_ENV=5502

# Database credentials
POSTGRES_USER=ml_pg_user
POSTGRES_PASSWORD=ml_pg_password
POSTGRES_DB=ml_pg_db

# --------------------------------------------
# Redis Cache/Session Configuration
# --------------------------------------------
# Redis 7 - Caching and session storage
# Inside host: Service name used within Docker network
# Outside host: localhost or IP used from host machine

REDIS_HOST_INSIDE_ENV=ml-redis
REDIS_HOST_OUTSIDE_ENV=ml_redis_password
REDIS_PORT_INSIDE_ENV=6379
REDIS_PORT_OUTSIDE_ENV=6601

# Redis authentication
REDIS_PASSWORD=ml_redis_password

# --------------------------------------------
# Additional Settings (Optional)
# --------------------------------------------

# Timezone
TZ=Asia/Ho_Chi_Minh

# Node Environment (production | development)
NODE_ENV=development

# PHP Environment (production | development)
APP_ENV=local
APP_DEBUG=true

# --------------------------------------------
# Docker Build Tag (auto-generated)
# --------------------------------------------
# This tag is automatically managed by build.sh
# Do not modify manually
DOCKER_TAG=86e3f81a-c5e7-406b-84fc-e88ef1a738b1

# --------------------------------------------
# NGINX Configuration
# --------------------------------------------
NGINX_PORT_INSIDE_ENV=80
NGINX_PORT_OUTSIDE_ENV=81
NGINX_PORT_SECURE_INSIDE_ENV=443
NGINX_PORT_SECURE_OUTSIDE_ENV=8443
